// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id               Int      @id @default(autoincrement())
  userId           BigInt   @unique @map("user_id")
  username         String?
  firstName        String?  @map("first_name")
  lastName         String?  @map("last_name")
  gameNickname     String   @default("") @map("game_nickname")
  gameId           String   @default("") @map("game_id")
  elo              Int      @default(100)
  level            Int      @default(1)
  acfBalance       Int      @default(0) @map("acf_balance")
  totalMatches     Int      @default(0) @map("total_matches")
  wins             Int      @default(0)
  losses           Int      @default(0)
  kills            Int      @default(0)
  deaths           Int      @default(0)
  assists          Int      @default(0)
  roundsPlayed     Int      @default(0) @map("rounds_played")
  winStreak        Int      @default(0) @map("win_streak")
  bestStreak       Int      @default(0) @map("best_streak")
  mvpCount         Int      @default(0) @map("mvp_count")
  referralCode     String?  @unique @map("referral_code")
  referredBy       Int?     @map("referred_by")
  referralCount    Int      @default(0) @map("referral_count")
  isBlocked        Boolean  @default(false) @map("is_blocked")
  blockUntil       String?  @map("block_until")
  blockCount       Int      @default(0) @map("block_count")
  isRegistered     Boolean  @default(false) @map("is_registered")
  isPremium        Boolean  @default(false) @map("is_premium")
  hasProLeague     Boolean  @default(false) @map("has_pro_league")
  premiumUntil     String?  @map("premium_until")
  registrationStep String   @default("start") @map("registration_step")
  createdAt        String   @default(dbgenerated("NOW()::text")) @map("created_at")
  lastActivity     String?  @map("last_activity")
  playerTag        String?  @map("player_tag")
  customTitle      String?  @map("custom_title")
  eloInsurance     Boolean  @default(false) @map("elo_insurance")
  seasonSkin       String?  @map("season_skin")

  mapStats         MapStat[]
  proLeagueStats   ProLeagueStat?
  proLeagueMapStats ProLeagueMapStat[]
  battlePass       BattlePass?
  matchPlayers     MatchPlayer[]

  @@map("players")
}

model MapStat {
  id        Int    @id @default(autoincrement())
  playerId  Int    @map("player_id")
  mapName   String @map("map_name")
  matches   Int    @default(0)
  wins      Int    @default(0)
  losses    Int    @default(0)
  kills     Int    @default(0)
  deaths    Int    @default(0)
  assists   Int    @default(0)

  player    Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, mapName])
  @@map("player_map_stats")
}

model ProLeagueStat {
  id           Int    @id @default(autoincrement())
  playerId     Int    @unique @map("player_id")
  elo          Int    @default(100)
  totalMatches Int    @default(0) @map("total_matches")
  wins         Int    @default(0)
  losses       Int    @default(0)
  kills        Int    @default(0)
  deaths       Int    @default(0)
  assists      Int    @default(0)
  winStreak    Int    @default(0) @map("win_streak")
  bestStreak   Int    @default(0) @map("best_streak")

  player       Player @relation(fields: [playerId], references: [id])

  @@map("pro_league_stats")
}

model ProLeagueMapStat {
  id        Int    @id @default(autoincrement())
  playerId  Int    @map("player_id")
  mapName   String @map("map_name")
  matches   Int    @default(0)
  wins      Int    @default(0)
  losses    Int    @default(0)
  kills     Int    @default(0)
  deaths    Int    @default(0)
  assists   Int    @default(0)

  player    Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, mapName])
  @@map("pro_league_map_stats")
}

model BattlePass {
  id        Int     @id @default(autoincrement())
  playerId  Int     @unique @map("player_id")
  isBought  Boolean @default(false) @map("is_bought")
  bpLevel   Int     @default(0) @map("bp_level")
  bpWins    Int     @default(0) @map("bp_wins")
  createdAt String? @map("created_at")

  player    Player  @relation(fields: [playerId], references: [id])

  @@map("battle_pass")
}

model Match {
  id              Int      @id @default(autoincrement())
  matchNumber     String   @unique @map("match_number")
  status          String   @default("searching")
  map             String?
  scoreT          Int      @default(0) @map("score_t")
  scoreCt         Int      @default(0) @map("score_ct")
  hostId          Int?     @map("host_id")
  groupId         BigInt?  @map("group_id")
  inviteLink      String?  @map("invite_link")
  pinnedMessageId Int?     @map("pinned_message_id")
  createdAt       String   @map("created_at")
  startedAt       String?  @map("started_at")
  finishedAt      String?  @map("finished_at")
  league          String   @default("default")

  matchPlayers    MatchPlayer[]

  @@map("matches")
}

model MatchPlayer {
  id          Int    @id @default(autoincrement())
  matchId     Int    @map("match_id")
  playerId    Int    @map("player_id")
  team        String @default("")
  kills       Int    @default(0)
  deaths      Int    @default(0)
  assists     Int    @default(0)
  eloChange   Int    @default(0) @map("elo_change")
  joinedLobby Boolean  @default(false) @map("joined_lobby")

  match       Match  @relation(fields: [matchId], references: [id])
  player      Player @relation(fields: [playerId], references: [id])

  @@map("match_players")
}

// ── Tables the bot uses but webapp doesn't query directly ────────────────────

model Queue {
  id          Int    @id @default(autoincrement())
  playerId    Int    @unique @map("player_id")
  queueNumber Int    @default(1) @map("queue_number")
  joinedAt    String @map("joined_at")
  league      String @default("default")

  @@map("queue")
}

model Party {
  id       Int    @id @default(autoincrement())
  code     String @unique
  leaderId Int    @map("leader_id")
  maxSize  Int    @default(2) @map("max_size")
  createdAt String @map("created_at")

  members  PartyMember[]

  @@map("parties")
}

model PartyMember {
  id       Int    @id @default(autoincrement())
  partyId  Int    @map("party_id")
  playerId Int    @map("player_id")
  joinedAt String @map("joined_at")

  party    Party  @relation(fields: [partyId], references: [id])

  @@map("party_members")
}

model DailyQuest {
  id          Int     @id @default(autoincrement())
  playerId    Int     @map("player_id")
  questType   String  @map("quest_type")
  questDate   String  @map("quest_date")
  target      Int     @default(1)
  progress    Int     @default(0)
  rewardAcf   Int     @default(0) @map("reward_acf")
  isCompleted Int     @default(0)     @map("is_completed")
  isClaimed   Int     @default(0)     @map("is_claimed")
  extraData   String  @default("") @map("extra_data")

  @@map("daily_quests")
}
