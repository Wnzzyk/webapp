# ── Webapp (.env) ────────────────────────────────────────────────────────────

# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Your Telegram Bot Token (for initData validation + file proxy)
BOT_TOKEN="123456789:ABCdefGhiJklMnopQRSTuvwxyz"

# Node environment
NODE_ENV="production"

# ── Bot (python_backend/.env additions) ──────────────────────────────────────
# Add these to your existing bot .env after migration:

# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
# DB_TYPE="postgres"   # new field - tell bot to use postgres

# ── Railway auto-injects these ────────────────────────────────────────────────
# RAILWAY_STATIC_URL  (your app URL, e.g. https://faceit-arena.up.railway.app)
# PORT                (Next.js listens on this)
